# Project base URL, for example https://your-project.supabase.co
# Do not append /rest/v1.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only origin for local invitation and password recovery testing.
# Production callbacks are hard-pinned in code to this canonical Luxa URL.
AUTH_EMAIL_CALLBACK_ORIGIN=https://luxa-dashboard.vercel.app
# Production authentication emails fail closed until the hosted Supabase URL
# configuration and checked-in templates have been manually verified.
SUPABASE_AUTH_EMAILS_VERIFIED=false
# Backward-compatible public URL for non-production environments.
NEXT_PUBLIC_APP_URL=

# Server-only CRM access. Point SUPABASE_URL at the same project as the public
# URL. Prefer a dashboard-specific sb_secret_ key. The legacy service-role key
# remains supported during migration.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Workspace identity is managed by Supabase Auth. Bootstrap the administrator with
# server-controlled app_metadata.role = "admin"; provision sales executives only
# through the admin invitation flow. No local session secret is used.

NEXT_PUBLIC_UMAMI_HOST_URL=
NEXT_PUBLIC_UMAMI_WEBSITE_ID=
NEXT_PUBLIC_UMAMI_ENABLED=true

# Server-only dashboard access. Use either an Umami Cloud API key or a
# self-hosted bearer token. Never prefix these with NEXT_PUBLIC_.
UMAMI_API_URL=
UMAMI_API_KEY=
UMAMI_API_TOKEN=
